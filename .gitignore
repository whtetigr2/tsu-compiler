dist/
build/
*.egg-info/

# Scratch output. `out/*` rather than `out/` so the evidence pack below can be
# re-included: git cannot re-include a path whose PARENT directory is excluded.
out/*
!out/extropic-verify/
!out/connectivity-cost/
!out/codon-sampleability/
!out/dtm-preflight/
!out/diagnostic-control/
!out/free-energy/
!out/z1t-preflight/
!out/softmax-boltzmann/
!out/doom-preflight/
!out/visibility/
!out/texture/
!out/game/
!out/moment-readout/
out_check/
worlds/

# Working archives -- these are scratch, and one of them was sitting inside
# src/ where it would have shipped with the package.
*.zip
*.tgz
*.tar.gz

# Generated world-render outputs -- regenerable from the scripts in demo/.
# Kept out of the repo: they were 14 MB of a 16 MB tree.
demo/*.png

# Multi-agent session trail. These are working artifacts of how the work got
# done, not the work: chat transcripts, phase sitreps, review scratch, handoff
# memos. A single `git add demo/` would otherwise turn the repository into an
# agent diary.
demo/model-chat/
demo/gibbs-observatory-*.md
demo/GIBBS_OBSERVATORY_PLAN.md
demo/_grok_*
*-review.md
*handoff*.md
